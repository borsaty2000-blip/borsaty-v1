generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Instrument {
  id             String      @id @default(cuid())
  symbol         String      @unique // canonical: "COMI"
  providerSymbol String      @unique // "COMI.CA" for EODHD
  nameAr         String
  nameEn         String
  aliases        String[]    // ["البنك الأهلي", "CIB", "Commercial International Bank"]
  assetClass     AssetClass
  market         Market
  sector         String?
  industry       String?
  currency       String      // EGP, SAR, USD
  isActive         Boolean     @default(true)
  dataSources      Json        // { primary: "sahmk", fallback: "eodhd" }
  historyStartDate DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  prices         Price[]
  signals        Signal[]

  @@index([market, assetClass, isActive])
  @@index([symbol])
}

model Company {
  id           String        @id @default(cuid())
  symbol       String        @unique // COMI, 2222
  nameAr       String
  nameEn       String
  aliases      String[]      // "البنك التجاري الدولي", "CIB", "الراجحي"
  market       Market        // EGX, TASI, NOMU, DFM, ADX, US
  sector       String?
  industry     String?
  currency     String        @default("EGP") // EGP, SAR, USD, QAR
  logoUrl      String?
  prices       Price[]
  fundamentals Fundamental[]
  signals      Signal[]
}

model Price {
  id           String      @id @default(cuid())
  companyId    String?
  company      Company?    @relation(fields: [companyId], references: [id])
  instrumentId String?
  instrument   Instrument? @relation(fields: [instrumentId], references: [id])
  timeframe    String      // 1m, 5m, 1h, 4h, 1d, 1w, 1mo
  timestamp    DateTime
  open         Float
  high         Float
  low          Float
  close        Float
  volume       BigInt?

  @@index([companyId, timeframe, timestamp])
  @@index([instrumentId, timeframe, timestamp])
}

model Fundamental {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  period        String   // FY2025, Q3-2026
  revenue       Float?
  netIncome     Float?
  eps           Float?
  peRatio       Float?
  pbRatio       Float?
  dividendYield Float?
  marketCap     Float?
  debtToEquity  Float?
  roe           Float?

  @@unique([companyId, period])
}

model Signal {
  id              String       @id @default(cuid())
  companyId       String?
  company         Company?     @relation(fields: [companyId], references: [id])
  instrumentId    String?
  instrument      Instrument?  @relation(fields: [instrumentId], references: [id])
  timeframe       String
  type            SignalType   // STRONG_BULLISH, BULLISH, NEUTRAL, etc.
  entry           Float
  stopLoss        Float
  targets         Float[]
  confluenceScore Int?
  reasons         String[]     // ["Elliott Wave 3", "Gann 1x1 reclaim"]
  contradicting   String[]     // ["MACD still bearish"]
  dataQuality     Json         // { missing: [...], warnings: [...] }
  status          SignalStatus // ACTIVE, HIT_T1, STOPPED, INVALIDATED
  createdAt       DateTime     @default(now())
  closedAt        DateTime?
  resultPct       Float?

  @@index([companyId, status, createdAt])
  @@index([instrumentId, status, createdAt])
}

enum AssetClass {
  EQUITY
  FOREX
  CRYPTO
  COMMODITY
  INDEX
}

enum Market {
  EGX
  TASI
  NOMU
  DFM
  ADX
  QE
  KW
  US
  UK
  DE
  JP
  GLOBAL
}

enum SignalType {
  STRONG_BULLISH
  BULLISH
  NEUTRAL
  BEARISH
  STRONG_BEARISH
}

enum SignalStatus {
  ACTIVE
  HIT_T1
  HIT_T2
  HIT_T3
  STOPPED
  INVALIDATED
}

model IndicatorValue {
  instrumentId     String
  timeframe        String
  indicator        String
  paramsHash       String
  indicatorVersion String
  timestamp        DateTime
  value            Float
  metadata         Json?

  @@id([instrumentId, timeframe, indicator, paramsHash, timestamp])
  @@index([instrumentId, timeframe, indicator])
}

model ScreenerQuery {
  id          String   @id @default(cuid())
  userId      String?
  queryAr     String
  parsedDsl   Json
  resultCount Int
  executionMs Int
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}
